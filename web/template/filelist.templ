package template

import (
	"encoding/json"
	"fmt"

	"github.com/omegaatt36/dub/internal/domain"
)

// FileList renders the source-of-truth table: every visible file, its proposed
// new name, and a tick box. Unticked rows stay in place (dimmed) so the user can
// see what they excluded and re-tick it, rather than having rows disappear.
templ FileList(data PageData) {
	<div
		id="file-list"
		class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 flex flex-col h-full min-h-0 overflow-hidden shadow-sm"
	>
		<div class="px-4 py-2.5 border-b border-gray-200 dark:border-gray-700 shrink-0 flex flex-wrap items-center gap-x-3 gap-y-1.5">
			<h3 class="text-sm font-semibold text-gray-900 dark:text-gray-200 tracking-wide shrink-0">
				if data.Pattern != "" {
					Matched
				} else {
					Files
				}
			</h3>
			<span class="text-xs px-2 py-0.5 rounded-full bg-gray-200 dark:bg-gray-700 text-gray-600 dark:text-gray-400 font-medium">{ fmt.Sprintf("%d", len(data.VisibleFiles)) }</span>
			if data.TickedCount > 0 && data.TickedCount < len(data.VisibleFiles) {
				<span class="text-xs px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-700 dark:text-blue-300 font-medium">{ fmt.Sprintf("%d", data.TickedCount) } selected</span>
			}
			<div class="ml-auto flex flex-wrap items-center gap-x-3 gap-y-1">
				<select
					id="sort-order"
					name="sort"
					aria-label="Sort files"
					class="text-xs bg-gray-100 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 rounded px-2 py-1 cursor-pointer hover:bg-gray-200 dark:hover:bg-gray-800 transition-colors"
					hx-post="/api/sort"
					hx-trigger="change"
					hx-target="#main-content"
					hx-swap="innerHTML"
					disabled?={ data.ScannedCount == 0 }
				>
					@sortOption("name:asc", "Name A–Z", data.SortOrder)
					@sortOption("name:desc", "Name Z–A", data.SortOrder)
					@sortOption("modified:desc", "Newest first", data.SortOrder)
					@sortOption("modified:asc", "Oldest first", data.SortOrder)
					@sortOption("size:desc", "Largest first", data.SortOrder)
					@sortOption("size:asc", "Smallest first", data.SortOrder)
				</select>
				<label class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400 cursor-pointer">
					<input
						id="show-hidden-files"
						type="checkbox"
						checked?={ data.ShowHiddenFiles }
						disabled?={ data.SelectedDirectory == "" }
						hx-post="/api/hidden-files"
						hx-vals={ showHiddenVals(!data.ShowHiddenFiles) }
						hx-target="#main-content"
						hx-swap="innerHTML"
						class="w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-2 focus:ring-blue-500/50 cursor-pointer"
					/>
					Show hidden files
					if data.HiddenCount > 0 {
						<span class="text-gray-400 dark:text-gray-500">{ fmt.Sprintf("(%d)", data.HiddenCount) }</span>
					}
				</label>
				<div class="flex items-center gap-1">
					<button
						type="button"
						class="text-xs px-2 py-1 rounded text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500"
						hx-post="/api/tick-all"
						hx-vals='{"ticked": "true"}'
						hx-target="#main-content"
						hx-swap="innerHTML"
						disabled?={ len(data.VisibleFiles) == 0 }
					>
						Select all
					</button>
					<span class="text-gray-300 dark:text-gray-600 text-xs" aria-hidden="true">·</span>
					<button
						type="button"
						class="text-xs px-2 py-1 rounded text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500"
						hx-post="/api/tick-all"
						hx-vals='{"ticked": "false"}'
						hx-target="#main-content"
						hx-swap="innerHTML"
						disabled?={ len(data.VisibleFiles) == 0 }
					>
						Clear
					</button>
				</div>
			</div>
		</div>
		<div data-dub-scroll="file-list" class="flex-1 overflow-auto relative min-h-0">
			if len(data.VisibleFiles) == 0 {
				@emptyState(data)
			} else if len(data.Previews) > 0 {
				@previewTable(data.Previews)
			} else {
				@nameTable(data.VisibleFiles, data.SelectedPaths)
			}
		</div>
	</div>
}

templ sortOption(value string, label string, current string) {
	<option value={ value } selected?={ value == current }>{ label }</option>
}

func showHiddenVals(show bool) string {
	return fmt.Sprintf(`{"show": %q}`, fmt.Sprint(show))
}

// emptyState says why the list is empty, because "empty" has four different
// causes with four different remedies.
templ emptyState(data PageData) {
	<div class="flex flex-col items-center justify-center h-full text-gray-500 dark:text-gray-400 p-8 text-center gap-1.5">
		<svg class="w-12 h-12 mb-2 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path></svg>
		if data.SelectedDirectory == "" {
			<p class="text-sm font-medium text-gray-700 dark:text-gray-300">Drop a folder here to begin</p>
			<p class="text-xs">or press <kbd class="font-mono px-1 py-0.5 rounded bg-gray-100 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-700">{ modKey() }O</kbd> to choose one.</p>
		} else if data.ScannedCount == 0 {
			<p class="text-sm">This folder has no files.</p>
		} else if data.TotalCount == 0 {
			<p class="text-sm">This folder has only hidden files.</p>
			<button
				type="button"
				class="mt-1 text-xs px-3 py-1.5 rounded-md bg-blue-600 hover:bg-blue-500 text-white font-medium transition-colors focus-visible:ring-2 focus-visible:ring-blue-500"
				hx-post="/api/hidden-files"
				hx-vals={ showHiddenVals(true) }
				hx-target="#main-content"
				hx-swap="innerHTML"
			>
				{ fmt.Sprintf("Show %d hidden file%s", data.HiddenCount, plural(data.HiddenCount)) }
			</button>
		} else {
			<p class="text-sm">No files match the current pattern.</p>
		}
	</div>
}

templ previewTable(previews []domain.RenamePreview) {
	<table class="w-full text-sm text-left border-collapse" aria-label="Rename preview">
		<thead class="sticky top-0 z-10 bg-white/95 dark:bg-gray-800/95 backdrop-blur shadow-sm text-xs font-bold text-gray-600 dark:text-gray-300 uppercase tracking-wider">
			<tr>
				<th scope="col" class="px-4 py-3 border-b border-gray-200 dark:border-gray-700">Original</th>
				<th scope="col" class="px-2 py-3 border-b border-gray-200 dark:border-gray-700 w-8"><span class="sr-only">Status</span></th>
				<th scope="col" class="px-4 py-3 border-b border-gray-200 dark:border-gray-700">New Name</th>
				<th scope="col" class="px-4 py-3 border-b border-gray-200 dark:border-gray-700 text-right w-24">Size</th>
			</tr>
		</thead>
		<tbody class="divide-y divide-gray-200/50 dark:divide-gray-700/50">
			for _, p := range previews {
				<tr
					class={ "group transition-colors duration-150",
						templ.KV("bg-red-50 dark:bg-red-900/15", p.Conflict),
						templ.KV("hover:bg-gray-100/50 dark:hover:bg-gray-700/50", !p.Conflict) }
				>
					<td class="px-4 py-2.5 max-w-xs truncate text-gray-900 dark:text-gray-300">
						<div class="flex items-center gap-2.5">
							@FileIcon(domain.FileTypeIcon(p.Extension))
							if len(p.OriginalDiff) > 0 {
								@DiffSegments(p.OriginalDiff)
							} else {
								<span class="truncate" title={ p.OriginalName }>{ p.OriginalName }</span>
							}
						</div>
					</td>
					<td class="px-2 py-2.5 text-center">
						if p.Conflict {
							<div class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-100 dark:bg-red-500/20 text-red-600 dark:text-red-400" title="Another file already has this name">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
							</div>
						} else if p.OriginalName != p.NewName {
							<span class="text-gray-400 dark:text-gray-500" aria-hidden="true">→</span>
						}
					</td>
					<td class="px-4 py-2.5 max-w-xs truncate">
						if p.Conflict {
							<span class="text-red-600 dark:text-red-400 font-medium" title="Another file already has this name">{ p.NewName }</span>
						} else if len(p.NewDiff) > 0 {
							@DiffSegments(p.NewDiff)
						} else if p.OriginalName != p.NewName {
							<span class="text-emerald-700 dark:text-emerald-400 font-medium">{ p.NewName }</span>
						} else {
							<span class="text-gray-400 dark:text-gray-500">{ p.NewName }</span>
						}
					</td>
					<td class="px-4 py-2.5 text-right text-gray-500 dark:text-gray-400 text-xs font-mono">
						@FormatSize(p.Size)
					</td>
				</tr>
			}
		</tbody>
	</table>
}

templ nameTable(files []domain.FileItem, selected map[string]bool) {
	<table class="w-full text-sm text-left border-collapse" aria-label="File list">
		<thead class="sticky top-0 z-10 bg-white/95 dark:bg-gray-800/95 backdrop-blur shadow-sm text-xs font-bold text-gray-600 dark:text-gray-300 uppercase tracking-wider">
			<tr>
				<th scope="col" class="px-4 py-3 border-b border-gray-200 dark:border-gray-700 w-10">
					<span class="sr-only">Selected</span>
				</th>
				<th scope="col" class="px-4 py-3 border-b border-gray-200 dark:border-gray-700">Name</th>
				<th scope="col" class="px-4 py-3 border-b border-gray-200 dark:border-gray-700 text-right w-24">Size</th>
			</tr>
		</thead>
		<tbody class="divide-y divide-gray-200/50 dark:divide-gray-700/50">
			for _, f := range files {
				// Previews are absent here, so previews[i] cannot be indexed; look
				// the row up by path instead of by position.
				<tr
					class={ "transition-colors duration-150",
					templ.KV("bg-gray-100/60 dark:bg-gray-900/30 opacity-60", !selected[f.Path]) }
				>
					<td class="px-4 py-2">
						<input
							type="checkbox"
							checked={ selected[f.Path] }
							hx-post="/api/tick"
							hx-vals={ tickVals(f.Path, selected[f.Path]) }
							hx-target="#main-content"
							hx-swap="innerHTML"
							aria-label={ tickLabel(f) }
							class="w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-2 focus:ring-blue-500/50 cursor-pointer"
						/>
					</td>
					<td class="px-4 py-2.5 max-w-xs truncate text-gray-900 dark:text-gray-300">
						<div class="flex items-center gap-2.5">
							@FileIcon(domain.FileTypeIcon(f.Extension))
							<span class="truncate" title={ f.Name }>{ f.Name }</span>
						</div>
					</td>
					<td class="px-4 py-2.5 text-right text-gray-500 dark:text-gray-400 text-xs font-mono">
						@FormatSize(f.Size)
					</td>
				</tr>
			}
		</tbody>
	</table>
}

// tickVals builds the htmx value map for a tick toggle. hx-vals is static, so
// it cannot observe the post-click state; the server therefore sends the
// inverse of the state it just rendered.
func tickVals(path string, currentlySelected bool) string {
	next := "false"
	if !currentlySelected {
		next = "true"
	}
	payload, err := json.Marshal(map[string]string{
		"path":   path,
		"ticked": next,
	})
	if err != nil {
		// A path that cannot be JSON-encoded cannot round-trip through the form
		// either, so the click simply does nothing rather than sending garbage.
		return "{}"
	}
	return string(payload)
}

func tickLabel(f domain.FileItem) string {
	return fmt.Sprintf("Include %s in the rename", f.Name)
}

templ DiffSegments(segments []domain.DiffSegment) {
	for _, seg := range segments {
		switch seg.Type {
			case domain.DiffEqual:
				<span>{ seg.Text }</span>
			case domain.DiffDelete:
				<span class="bg-red-200 dark:bg-red-900/40 text-red-700 dark:text-red-400 line-through rounded-sm px-0.5">{ seg.Text }</span>
			case domain.DiffInsert:
				<span class="bg-emerald-200 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-400 rounded-sm px-0.5">{ seg.Text }</span>
		}
	}
}
