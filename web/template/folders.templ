package template

import (
	"encoding/json"
	"fmt"
	"strconv"
)

// FolderNode is one folder in the tree. Children are only filled in while the
// node is open, so building the tree reads one directory per open folder.
type FolderNode struct {
	Name     string
	Path     string
	Current  bool
	Expanded bool
	// Unreadable marks an open folder the app could not list, for instance one
	// the OS has not granted access to.
	Unreadable bool
	Children   []FolderNode
}

// FolderTree is the browsing sidebar. Choosing a folder scans it; the chevron
// only opens or closes it, and swaps just the tree so the file list and the
// naming work are left alone.
templ FolderTree(roots []FolderNode) {
	<nav
		id="folder-tree"
		aria-label="Folders"
		class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 flex flex-col h-full min-h-0 overflow-hidden shadow-sm"
	>
		<h3 class="px-4 py-2.5 border-b border-gray-200 dark:border-gray-700 shrink-0 text-sm font-semibold text-gray-900 dark:text-gray-200 tracking-wide">Folders</h3>
		<div data-dub-scroll="folder-tree" class="flex-1 overflow-auto min-h-0 py-1.5">
			if len(roots) == 0 {
				<p class="px-4 py-3 text-xs text-gray-500 dark:text-gray-400">Open a folder to browse from here.</p>
			} else {
				<ul>
					for _, root := range roots {
						@folderNode(root, 0)
					}
				</ul>
			}
		</div>
	</nav>
}

templ folderNode(node FolderNode, depth int) {
	<li>
		<div
			class={ "flex items-center rounded-md mx-1.5 pr-1.5",
				templ.KV("bg-blue-500/10", node.Current),
				templ.KV("hover:bg-gray-100 dark:hover:bg-gray-700/60", !node.Current) }
			style={ indent(depth) }
		>
			<button
				type="button"
				class="shrink-0 p-1 rounded text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-200 focus-visible:ring-2 focus-visible:ring-blue-500"
				hx-post="/api/tree/toggle"
				hx-vals={ jsonVals(map[string]string{"path": node.Path}) }
				hx-target="#folder-tree"
				hx-swap="outerHTML"
				aria-expanded={ strconv.FormatBool(node.Expanded) }
				aria-label={ toggleLabel(node) }
			>
				<svg class={ "w-3 h-3 transition-transform", templ.KV("rotate-90", node.Expanded) } fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
			</button>
			if node.Current {
				<span class="flex items-center gap-1.5 min-w-0 py-1 text-xs font-semibold text-blue-700 dark:text-blue-300" aria-current="true" title={ node.Path }>
					@folderIcon()
					<span class="truncate">{ node.Name }</span>
				</span>
			} else {
				<button
					type="button"
					class="flex items-center gap-1.5 min-w-0 flex-1 py-1 text-left text-xs text-gray-700 dark:text-gray-300 rounded focus-visible:ring-2 focus-visible:ring-blue-500"
					hx-post="/api/scan"
					hx-vals={ jsonVals(map[string]string{"path": node.Path}) }
					hx-target="#main-content"
					hx-swap="innerHTML"
					title={ node.Path }
				>
					@folderIcon()
					<span class="truncate">{ node.Name }</span>
				</button>
			}
		</div>
		if node.Expanded {
			<ul>
				for _, child := range node.Children {
					@folderNode(child, depth+1)
				}
				if node.Unreadable {
					<li class="py-1 text-xs italic text-amber-700 dark:text-amber-300" style={ indent(depth+1) }>Cannot open this folder</li>
				} else if len(node.Children) == 0 {
					<li class="py-1 text-xs italic text-gray-400 dark:text-gray-500" style={ indent(depth+1) }>No subfolders</li>
				}
			</ul>
		}
	</li>
}

templ folderIcon() {
	<svg class="w-3.5 h-3.5 shrink-0 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
}

// indent offsets a row by its depth. It is a style rather than a class because
// the depth is unbounded and Tailwind only emits classes it can see in source.
func indent(depth int) string {
	return fmt.Sprintf("padding-left: %.2frem", 0.25+0.75*float64(depth))
}

func toggleLabel(node FolderNode) string {
	if node.Expanded {
		return "Collapse " + node.Name
	}
	return "Expand " + node.Name
}

// jsonVals builds an hx-vals payload. A path may hold quotes, so it is encoded
// rather than spliced into a string.
func jsonVals(vals map[string]string) string {
	payload, err := json.Marshal(vals)
	if err != nil {
		// Strings always marshal; if this ever fails the click sends nothing.
		return "{}"
	}
	return string(payload)
}
