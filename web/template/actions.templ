package template

import "fmt"

// Actions is the full-width footer bar. It owns the only destructive control in
// the app, so it states the blast radius ("N files") and any blocking problem
// (conflicts) before the button, not in a tooltip after the click.
templ Actions(data PageData) {
	<div class="shrink-0 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2.5 flex items-center gap-4">
		<div class="flex items-center gap-2 text-sm min-w-0">
			@statusSummary(data)
		</div>
		<div class="ml-auto flex items-center gap-2 shrink-0">
			if data.CanUndo && len(data.Previews) == 0 {
				<button
					type="button"
					class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 px-3 py-1.5 rounded text-sm font-medium transition-colors hover:bg-gray-100 dark:hover:bg-gray-700 focus-visible:ring-2 focus-visible:ring-amber-500"
					hx-post="/api/undo"
					hx-target="#main-content"
					hx-swap="innerHTML"
					title="Undo the last rename (⌘Z)"
				>
					Undo
				</button>
			}
			if len(data.Previews) > 0 {
				<button
					type="button"
					class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 px-3 py-1.5 rounded text-sm font-medium transition-colors hover:bg-gray-100 dark:hover:bg-gray-700 focus-visible:ring-2 focus-visible:ring-gray-400"
					hx-post="/api/preview"
					hx-target="#main-content"
					hx-swap="innerHTML"
					hx-vals='{"clear": "true"}'
				>
					Discard
				</button>
			}
			if data.ConflictCount > 0 {
				<span
					class="bg-gray-300 dark:bg-gray-600 text-white px-4 py-1.5 rounded-md text-sm font-semibold cursor-not-allowed opacity-70 inline-flex items-center gap-2"
					aria-disabled="true"
					title="Rename is blocked until the conflicting names above are made unique"
				>
					Resolve { fmt.Sprintf("%d", data.ConflictCount) } conflict{ plural(data.ConflictCount) }
				</span>
			} else if len(data.Previews) > 0 {
				@confirmExecute(data)
			}
		</div>
		if data.Result != nil {
			@resultBanner(data)
		}
	</div>
}

// statusSummary tells the user what a click would do before they click it.
templ statusSummary(data PageData) {
	if data.SelectedDirectory == "" {
		<span class="text-gray-500 dark:text-gray-400 italic">Select a directory to get started.</span>
	} else if len(data.VisibleFiles) == 0 {
		<span class="text-gray-500 dark:text-gray-400 italic">No files match the current filter.</span>
	} else if len(data.Previews) > 0 {
		<span class="text-gray-600 dark:text-gray-300">
			Ready to rename <span class="font-semibold text-gray-900 dark:text-gray-100">{ fmt.Sprintf("%d", len(data.Previews)) }</span> file{ plural(len(data.Previews)) }
		</span>
	} else if data.TickedCount > 0 {
		<span class="text-gray-600 dark:text-gray-300">
			<span class="font-semibold text-gray-900 dark:text-gray-100">{ fmt.Sprintf("%d", data.TickedCount) }</span> of { fmt.Sprintf("%d", len(data.VisibleFiles)) } selected — set new names to continue
		</span>
	} else {
		<span class="text-gray-500 dark:text-gray-400 italic">Tick the files you want to rename.</span>
	}
}

// confirmExecute is a two-step confirm for the only destructive action in the
// app. Both steps are server-rendered; the confirm half is hidden with the
// dedicated [hidden] attribute rather than a utility class, because that is
// state the JS toggles directly and a class swap would silently no-op if the
// class were ever dropped from the markup.
templ confirmExecute(data PageData) {
	<div id="execute-confirm" hidden class="flex items-center gap-2">
		<span class="text-sm text-gray-600 dark:text-gray-300 whitespace-nowrap" role="status">
			Rename { fmt.Sprintf("%d", len(data.Previews)) } file{ plural(len(data.Previews)) }?
		</span>
		<button
			type="button"
			class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-1.5 rounded-md text-sm font-semibold shadow-sm transition-colors focus-visible:ring-2 focus-visible:ring-emerald-500"
			hx-post="/api/execute"
			hx-target="#main-content"
			hx-swap="innerHTML"
		>
			Yes, rename
		</button>
		<button
			type="button"
			class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 px-3 py-1.5 rounded text-sm font-medium transition-colors hover:bg-gray-100 dark:hover:bg-gray-700 focus-visible:ring-2 focus-visible:ring-gray-400"
			onclick="window.__dubConfirm(false)"
		>
			Cancel
		</button>
		if data.ExtChangeCount > 0 {
			<span class="flex items-center gap-1.5 text-xs text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-700/50 rounded px-2 py-1 whitespace-nowrap" role="alert">
				<svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
				{ fmt.Sprintf("%d", data.ExtChangeCount) } extension{ plural(data.ExtChangeCount) } will change; contents are not converted
			</span>
		}
	</div>
	<button
		id="execute-btn"
		type="button"
		class="bg-emerald-600 hover:bg-emerald-500 text-white px-5 py-1.5 rounded-md text-sm font-semibold shadow-md shadow-emerald-900/20 transition-all active:scale-95 inline-flex items-center gap-2 focus-visible:ring-2 focus-visible:ring-emerald-500"
		onclick="window.__dubConfirm(true)"
	>
		<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
		Execute Rename
	</button>
}

templ resultBanner(data PageData) {
	if data.Result.Success {
		<div class="fixed bottom-16 right-4 bg-emerald-50 dark:bg-emerald-900 border border-emerald-200 dark:border-emerald-700 text-emerald-900 dark:text-emerald-100 px-4 py-3 rounded-lg shadow-lg max-w-md z-50 flex items-start gap-2" role="status">
			<svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
			<div>
				<p class="text-sm font-semibold">{ data.Result.Message }</p>
				if len(data.Result.Errors) > 0 {
					<ul class="mt-1 list-disc list-inside text-xs opacity-90 space-y-0.5">
						for _, e := range data.Result.Errors {
							<li>{ e }</li>
						}
					</ul>
				}
			</div>
		</div>
	} else {
		<div class="fixed bottom-16 right-4 bg-amber-50 dark:bg-amber-900 border border-amber-200 dark:border-amber-700 text-amber-900 dark:text-amber-100 px-4 py-3 rounded-lg shadow-lg max-w-md z-50 flex items-start gap-2" role="alert">
			<svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path></svg>
			<div>
				<p class="text-sm font-semibold">{ data.Result.Message }</p>
				if len(data.Result.Errors) > 0 {
					<ul class="mt-1 list-disc list-inside text-xs opacity-90 space-y-0.5">
						for _, e := range data.Result.Errors {
							<li>{ e }</li>
						}
					</ul>
				}
				if len(data.Result.RollbackErrors) > 0 {
					<p class="mt-1 font-medium text-xs">Rollback also failed:</p>
					<ul class="mt-0.5 list-disc list-inside text-xs opacity-90 space-y-0.5">
						for _, e := range data.Result.RollbackErrors {
							<li>{ e }</li>
						}
					</ul>
				}
			</div>
		</div>
	}
}

func plural(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}