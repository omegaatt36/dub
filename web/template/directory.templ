package template

import "strconv"

// Crumb is one segment of the current directory's path.
type Crumb struct {
	Name string
	Path string
}

// maxCrumbs bounds the path shown in the bar. A deeper path keeps its home (or
// root) crumb and its tail, since the folders nearest the leaf are the ones
// that identify it; an ellipsis stands for the rest and jumps to the nearest
// of them.
const maxCrumbs = 4

// DirectoryBar is the row above the panes: the Open button, the controls for
// the sidebar and a refresh, and the current path, where every ancestor is a
// link back up. It lives inside the swapped content so it follows every change
// of directory.
templ DirectoryBar(data PageData) {
	<div class="shrink-0 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 px-4 py-2 flex items-center gap-3">
		<button
			type="button"
			class="shrink-0 bg-blue-600 hover:bg-blue-500 text-white px-3 py-1.5 rounded-md text-xs font-semibold shadow-sm transition-all active:scale-95 flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-blue-500"
			hx-post="/api/select-directory"
			hx-target="#main-content"
			hx-swap="innerHTML"
			title={ "Choose a folder (" + modKey() + "O)" }
		>
			<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
			Open
		</button>
		<button
			type="button"
			class="shrink-0 p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500"
			hx-post="/api/tree/visibility"
			data-focus-key="toolbar:sidebar"
			hx-vals={ jsonVals(map[string]string{"hide": strconv.FormatBool(!data.HideTree)}) }
			hx-target="#main-content"
			hx-swap="innerHTML"
			title={ sidebarLabel(data.HideTree) }
			aria-label={ sidebarLabel(data.HideTree) }
			aria-pressed={ strconv.FormatBool(!data.HideTree) }
		>
			<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1zm5 0v14"></path></svg>
		</button>
		if len(data.Crumbs) > 0 {
			@breadcrumb(data.Crumbs, data.SelectedDirectory)
			<button
				type="button"
				data-copy-path={ data.SelectedDirectory }
				data-focus-key="toolbar:copy"
				class="shrink-0 p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500"
				title="Copy path"
				aria-label="Copy path"
			>
				<svg data-copy-icon class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
				<svg data-copied-icon class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
			</button>
			<button
				type="button"
				class="shrink-0 p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500"
				hx-post="/api/refresh"
				data-focus-key="toolbar:refresh"
				hx-target="#main-content"
				hx-swap="innerHTML"
				title={ "Refresh the folder (" + modKey() + "R)" }
				aria-label="Refresh the folder"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M5.6 15A8 8 0 0019 13M18.4 9A8 8 0 005 11"></path></svg>
			</button>
		} else {
			<span class="text-xs text-gray-500 dark:text-gray-400 italic truncate">No folder selected</span>
		}
	</div>
}

func sidebarLabel(hidden bool) string {
	if hidden {
		return "Show the folder tree"
	}
	return "Hide the folder tree"
}

// paneColumns lays out the three panes, or the two that remain without the
// folder tree.
func paneColumns(hideTree bool) templ.SafeCSS {
	if hideTree {
		return "grid-template-columns: minmax(0, 3fr) minmax(0, 2fr)"
	}
	return "grid-template-columns: 14rem minmax(0, 3fr) minmax(0, 2fr)"
}

templ breadcrumb(crumbs []Crumb, fullPath string) {
	<nav aria-label="Current folder" class="min-w-0 overflow-hidden" title={ fullPath }>
		<ol class="flex items-center gap-1 text-xs font-mono text-gray-700 dark:text-gray-300 min-w-0">
			if len(crumbs) > maxCrumbs {
				@crumbItems(crumbs[:1], true)
				<li class="text-gray-300 dark:text-gray-600 shrink-0" aria-hidden="true">/</li>
				<li class="shrink-0">
					@crumbButton(Crumb{Name: "…", Path: crumbs[len(crumbs)-maxCrumbs].Path})
				</li>
				<li class="text-gray-300 dark:text-gray-600 shrink-0" aria-hidden="true">/</li>
				@crumbItems(crumbs[len(crumbs)-maxCrumbs+1:], false)
			} else {
				@crumbItems(crumbs, false)
			}
		</ol>
	</nav>
}

// crumbItems renders a run of crumbs. The last of the whole path is the current
// folder and not a link; detached marks a run that is followed by more crumbs,
// so its last item is still a link.
templ crumbItems(crumbs []Crumb, detached bool) {
	for i, c := range crumbs {
		if i > 0 {
			<li class="text-gray-300 dark:text-gray-600 shrink-0" aria-hidden="true">/</li>
		}
		if i == len(crumbs)-1 && !detached {
			<li class="font-semibold text-gray-900 dark:text-gray-100 truncate min-w-0" aria-current="page">{ c.Name }</li>
		} else {
			<li class="min-w-0 shrink">
				@crumbButton(c)
			</li>
		}
	}
}

templ crumbButton(c Crumb) {
	<button
		type="button"
		class="block max-w-[12rem] truncate px-1 py-0.5 rounded hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-gray-100 transition-colors focus-visible:ring-2 focus-visible:ring-blue-500"
		hx-post="/api/scan"
		hx-vals={ jsonVals(map[string]string{"path": c.Path}) }
		hx-target="#main-content"
		hx-swap="innerHTML"
		title={ c.Path }
	>{ c.Name }</button>
}

// DiscardPrompt asks before a directory change throws away typed names. It is
// not a modal: the names stay on screen and editable until the user decides.
// It floats over the top of the panes instead of pushing them down, so the
// layout does not jump, and takes focus when it appears so Enter and Esc work
// without a trip through the mouse.
templ DiscardPrompt(pendingDir string) {
	if pendingDir != "" {
		<div class="relative h-0 shrink-0 z-40">
			<div
				id="discard-prompt"
				data-autofocus-key={ pendingDir }
				class="absolute inset-x-4 top-2 bg-amber-50 dark:bg-amber-900 border border-amber-200 dark:border-amber-700/50 rounded-lg shadow-lg px-4 py-2 flex items-center gap-3 text-sm text-amber-900 dark:text-amber-100"
				role="alert"
			>
				<span class="min-w-0 truncate">Opening <span class="font-semibold" title={ pendingDir }>{ baseName(pendingDir) }</span> discards the names you typed.</span>
				<div class="ml-auto flex items-center gap-2 shrink-0">
					<button
						type="button"
						class="text-xs px-3 py-1.5 rounded-md bg-amber-600 hover:bg-amber-500 text-white font-semibold transition-colors focus-visible:ring-2 focus-visible:ring-amber-500"
						hx-post="/api/scan"
						hx-vals={ jsonVals(map[string]string{"path": pendingDir, "discard": "true"}) }
						hx-target="#main-content"
						hx-swap="innerHTML"
					>
						Discard and open
					</button>
					<button
						type="button"
						data-autofocus
						data-discard-cancel
						class="text-xs px-3 py-1.5 rounded-md text-amber-900 dark:text-amber-100 hover:bg-amber-100 dark:hover:bg-amber-800/50 font-medium transition-colors focus-visible:ring-2 focus-visible:ring-amber-500"
						hx-post="/api/scan/cancel"
						hx-target="#main-content"
						hx-swap="innerHTML"
					>
						Keep editing
					</button>
				</div>
			</div>
		</div>
	}
}
